# Ignore packaging artifacts and backups
argon_context.zip
argon_package.zip
*.zip
.argon_backup/
argon_response.txt
argon_task_prompt.md
apply_changes.ps1
apply_changes.ps1.bak-*
*.bak-*
# The task brief and the API index are generated by the packager
TASK_BRIEF.md
API_INDEX.md

# Run logs written by the dispatcher and the helper scripts
*.log

# Python bytecode
__pycache__/
*.pyc

# Delivered Argon patches land here
downloads/

# Scratch working folder (comparison reports, merged patches, notes)
scratch/

# Account pool credentials and local secrets (never commit or upload plaintext passwords)
skills/argon-coding-bridge/config/accounts_pool.json
**/accounts_pool*.json
*credentials*.json
*secrets*.json
.env*
# A report the pool login tool writes next to the credentials
login_report.json

# System & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
.argon_quarantine/
